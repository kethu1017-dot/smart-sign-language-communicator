const videoElement = document.getElementById("webcam");
const canvasElement = document.getElementById("output");
const canvasCtx = canvasElement.getContext("2d");
const resultText = document.getElementById("result");
const startBtn = document.getElementById("startBtn");

let lastSign = "";
let lastSpeechTime = 0;

const handOptions = {
  locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`
};

const hands = new Hands(handOptions);
hands.setOptions({
  maxNumHands: 1,
  modelComplexity: 1,
  minDetectionConfidence: 0.7,
  minTrackingConfidence: 0.7
});

hands.onResults(onResults);

const camera = new Camera(videoElement, {
  onFrame: async () => {
    await hands.send({ image: videoElement });
  },
  width: 640,
  height: 480
});

function onResults(results) {
  canvasCtx.save();
  canvasCtx.clearRect(0, 0, canvasElement.width, canvasElement.height);

  canvasCtx.drawImage(
    results.image,
    0,
    0,
    canvasElement.width,
    canvasElement.height
  );

  if (results.multiHandLandmarks) {
    for (const landmarks of results.multiHandLandmarks) {
      drawConnectors(canvasCtx, landmarks, HAND_CONNECTIONS, {
        color: "#00FF00",
        lineWidth: 3
      });

      drawLandmarks(canvasCtx, landmarks, {
        color: "#FFFFFF",
        lineWidth: 1,
        radius: 4
      });

      const sign = detectGesture(landmarks);
      resultText.textContent = sign;

      speakIfNeeded(sign);
    }
  } else {
    resultText.textContent = "No hand detected";
  }

  canvasCtx.restore();
}

function detectGesture(landmarks) {
  const pts = landmarks;

  const fingerTips = [8, 12, 16, 20];
  const fingerPIPs = [6, 10, 14, 18];
  const fingerMCPs = [5, 9, 13, 17];

  let extendedCount = 0;

  for (let i = 0; i < fingerTips.length; i++) {
    const tip = pts[fingerTips[i]];
    const pip = pts[fingerPIPs[i]];
    const mcp = pts[fingerMCPs[i]];

    if (tip.y < pip.y && pip.y < mcp.y) {
      extendedCount++;
    }
  }

  // Index finger raised
  const indexTip = pts[8];
  const indexPip = pts[6];
  const indexMcp = pts[5];
  const isIndexExtended = indexTip.y < indexPip.y && indexPip.y < indexMcp.y;

  // Thumb open
  const thumbTip = pts[4];
  const thumbIp = pts[3];
  const isThumbExtended = thumbTip.x < thumbIp.x;

  // Fist detection: all fingers bent
  const isFist = extendedCount === 0;

  // Open palm detection
  const isOpenPalm = extendedCount >= 3;

  // Thumb + index pinch
  const distanceThumbIndex = distance(pts[4], pts[8]);
  const isPinch = distanceThumbIndex < 0.08;

  // Index and pinky extended, others bent
  const middleExtended = pts[12].y < pts[10].y && pts[10].y < pts[9].y;
  const ringExtended = pts[16].y < pts[14].y && pts[14].y < pts[13].y;
  const pinkyExtended = pts[20].y < pts[18].y && pts[18].y < pts[17].y;

  if (isFist) return "NO";
  if (isPinch) return "THANK YOU";
  if (isOpenPalm) return "HELLO";
  if (isIndexExtended && !middleExtended && !ringExtended && !pinkyExtended) return "YES";
  if (isIndexExtended && pinkyExtended && !middleExtended && !ringExtended) return "LOVE YOU";

  return "Unknown";
}

function distance(a, b) {
  return Math.hypot(a.x - b.x, a.y - b.y);
}

function speakIfNeeded(sign) {
  const now = Date.now();

  if (sign === "Unknown") return;

  if (sign !== lastSign || now - lastSpeechTime > 1800) {
    lastSign = sign;
    lastSpeechTime = now;
    speak(sign);
  }
}

function speak(text) {
  if ("speechSynthesis" in window) {
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = "en-US";
    utterance.rate = 1.0;
    speechSynthesis.cancel();
    speechSynthesis.speak(utterance);
  }
}

startBtn.addEventListener("click", async () => {
  try {
    await camera.start();
    startBtn.textContent = "Camera Running";
    startBtn.disabled = true;
  } catch (error) {
    alert("Camera access is blocked or not available. Please allow camera permission.");
    console.error(error);
  }
});